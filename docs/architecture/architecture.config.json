      "forbiddenSourceTokens": [
        {
          "path": "src-tauri/src/voice_controller.rs",
          "token": "type SharedRuntime = Arc<Mutex<VoiceRuntime>>",
          "reason": "implemented 状态要求 Actor 按值独占会话聚合，不能继续共享可变 Runtime"
        },
        {
          "path": "src-tauri/src/voice_controller.rs",
          "token": "runtime: SharedRuntime",
          "reason": "implemented 状态要求工作任务只返回内部事件，不能接收可写 Runtime"
        }
      ]
    }
  ],
