{
  "schemaVersion": 3,
  "architectureDir": "docs/architecture",
  "featureDir": "docs/features",
  "featureSchema": "docs/features/feature-dossier.schema.json",
  "proposalDir": "docs/architecture/proposals",
  "postmortemDir": "docs/postmortems",
  "knowledgeEntries": ["README.md", "docs/architecture.md", "docs/troubleshooting.md"],
  "codeMap": "docs/architecture/code-map.json",
  "codeMapSchema": "docs/architecture/code-map.schema.json",
  "facts": "docs/architecture/architecture-facts.json",
  "implementationClaimChecks": [
    {
      "featureId": "FEAT-VOICE-INPUT-CONTROL-PLANE",
      "whenImplementationStatus": "implemented",
      "forbiddenSourceTokens": [
        {
          "path": "src-tauri/src/voice_controller/actor/runtime.rs",
          "token": "Arc<Mutex<VoiceRuntime>>",
          "reason": "implemented 状态要求 Actor 按值独占会话聚合，不能继续共享可变 Runtime"
        },
        {
          "path": "src-tauri/src/voice_controller/actor/runtime.rs",
          "token": "Recorder",
          "reason": "Runtime 只能保存纯控制状态，不能拥有音频设备"
        },
        {
          "path": "src-tauri/src/voice_controller/actor/runtime.rs",
          "token": "SessionResources",
          "reason": "执行资源必须与纯 Runtime 分离"
        },
        {
          "path": "src-tauri/src/voice_controller/workflow/start.rs",
          "token": "VoiceRuntime",
          "reason": "Start worker 只能返回类型化结果，不能接收可写 Runtime"
        },
        {
          "path": "src-tauri/src/voice_controller/workflow/finalize.rs",
          "token": "VoiceRuntime",
          "reason": "Finalize worker 只能返回类型化结果，不能接收可写 Runtime"
        },
        {
          "path": "src-tauri/src/voice_controller/workflow/pending.rs",
          "token": "VoiceRuntime",
          "reason": "Pending worker 只能返回类型化结果，不能接收可写 Runtime"
        },
        {
          "path": "src-tauri/src/streaming_pipeline.rs",
          "token": "overlay::",
          "reason": "Streaming Pipeline 必须通过 Presenter 发布展示事件"
        }
      ]
    }
  ],
  "requiredDocs": [
    "README.md",
    "arc42-lean.md",
    "c4-context.md",
    "c4-container.md",
    "c4-components-backend.md",
    "c4-components-frontend.md",
    "runtime-views.md",
    "invariants.md",
    "code-map.md",
    "maintenance.md",
    "adr/README.md",
    "adr/template.md",
    "proposals/README.md"
  ],
  "sourceCoverage": [
    {
      "root": "src",
      "extensions": [".ts", ".tsx", ".css"],
      "excludeSuffixes": [".test.ts", ".test.tsx"]
    },
    {
      "root": "src-tauri/src",
      "extensions": [".rs"],
      "excludeSuffixes": []
    }
  ]
}
