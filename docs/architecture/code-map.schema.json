{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gy-typing.local/schemas/code-map.schema.json",
  "title": "GY Typing architecture code map",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "system", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "system": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "status",
        "owner",
        "source",
        "docs",
        "adrs",
        "dependsOn",
        "publicContracts",
        "changeTriggers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["active", "external", "experimental", "deprecated"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "source": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationGuides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adrs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "publicContracts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "changeTriggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
