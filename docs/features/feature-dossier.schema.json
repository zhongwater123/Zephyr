{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gy-typing.local/schemas/feature-dossier.schema.json",
  "title": "GY Typing Feature Dossier metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "featureId",
    "specStatus",
    "implementationStatus",
    "validationStatus",
    "components",
    "decisions",
    "validationSlices",
    "evidence",
    "impactAssessments",
    "implementationReview"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "featureId": { "type": "string", "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "authority": {
      "enum": ["mvp_contract", "hard_boundary", "reference"],
      "default": "mvp_contract"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmedBy", "confirmedAt", "sourceRef"],
      "properties": {
        "confirmedBy": { "type": "string", "minLength": 1 },
        "confirmedAt": { "type": "string", "format": "date" },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "specStatus": { "enum": ["draft", "confirmed", "superseded"] },
    "implementationStatus": {
      "enum": ["not_started", "in_progress", "implemented", "deprecated", "superseded"]
    },
    "implementationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceRevision", "worktreeState", "reviewedAt", "summary", "knownDeviations"],
      "properties": {
        "status": { "enum": ["unreviewed", "partial", "conformant", "deviating"] },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "worktreeState": { "enum": ["clean", "dirty", "unknown"] },
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewedAt": { "type": "string", "format": "date" },
        "summary": { "type": "string", "minLength": 1 },
        "knownDeviations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validationStatus": { "enum": ["unverified", "partial", "validated", "invalidated"] },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" }
    },
    "validationSlices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "components", "requiredEvidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["static_review", "automated", "windows_webview2", "runtime_hook", "fault_injection", "restart_persistence", "external_app_interop", "human_quality_eval", "usability_observation", "release_artifact"]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "acceptanceIds",
          "acceptanceCoverage",
          "method",
          "result",
          "freshness",
          "capabilities",
          "scope",
          "limitations",
          "sourceRevision",
          "worktreeState",
          "environment",
          "validatedAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^EV-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" }
          },
          "acceptanceCoverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acceptanceId", "coverage"],
              "properties": {
                "acceptanceId": { "type": "string", "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
                "coverage": { "enum": ["full", "partial"] }
              }
            }
          },
          "method": { "enum": ["automated", "manual", "historical_observation", "static_review"] },
          "result": { "enum": ["pass", "fail", "partial"] },
          "freshness": { "enum": ["current", "potentially_stale", "stale", "revalidated"] },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["static_review", "automated", "windows_webview2", "runtime_hook", "fault_injection", "restart_persistence", "external_app_interop", "human_quality_eval", "usability_observation", "release_artifact"]
            }
          },
          "scope": { "type": "string", "minLength": 1 },
          "testRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "worktreeState": { "enum": ["clean", "dirty", "unknown"] },
          "changedPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "buildId": { "type": "string", "minLength": 1 },
          "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "environment": { "type": "string", "minLength": 1 },
          "validatedAt": { "type": "string", "format": "date" }
        },
        "allOf": [
          {
            "if": { "properties": { "method": { "const": "automated" } } },
            "then": { "required": ["testRefs"], "properties": { "testRefs": {} } }
          }
        ]
      }
    },
    "impactAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "acceptanceIds", "assessedRevision", "assessedAt", "outcome", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^IA-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$" }
          },
          "assessedRevision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "assessedAt": { "type": "string", "format": "date" },
          "outcome": { "enum": ["evidence_still_valid", "revalidation_required"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "specStatus": { "const": "confirmed" } } },
      "then": {
        "required": ["confirmation"],
        "properties": {
          "confirmation": {},
          "validationSlices": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "validationStatus": { "const": "validated" } } },
      "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "implementationStatus": { "const": "implemented" } } },
      "then": {
        "properties": {
          "implementationReview": {
            "type": "object",
            "properties": {
              "status": { "enum": ["partial", "conformant"] },
              "knownDeviations": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    }
  ]
}
